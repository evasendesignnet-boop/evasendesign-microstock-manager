{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EvaSenDesign Microstock Manager",
  "version": "0.1.0",
  "identifier": "net.evasendesign.microstock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EvaSenDesign Microstock Manager",
        "width": 1180,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}